# Idemaq — exemplo de configuracao de env vars
#
# Pra rodar localmente:
#   1. Copiar este arquivo pra .env.local (ja esta no .gitignore via *.local)
#   2. Preencher os valores reais (anon key e url publicos do Supabase)
#   3. Reiniciar `npm run dev`
#
# Pra deploy no Vercel:
#   Settings -> Environment Variables -> adicionar cada VITE_* pra
#   Production + Preview + Development.

# Supabase (obrigatorio)
# https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://yfbbruxqfzgetapbvrgd.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_LjPdeaBlBZ9rBNMT0lk8Nw_oyI01iqP

# Google Maps Places (opcional — AddressInput cai pra texto livre se vazio)
# https://console.cloud.google.com/google/maps-apis/credentials
# Habilitar: Places API (New) + Maps JavaScript API
# Restringir por HTTP referrer: idemaq.vercel.app/* + localhost:5173/*
VITE_GOOGLE_MAPS_KEY=
